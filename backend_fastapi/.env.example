# ==============================================================================
# FastAPI Backend Configuration Template
# Copy this file to .env inside backend_fastapi/ directory:
#   cp .env.example .env
# ==============================================================================

# Server Network Settings
PORT=8001
HOST=0.0.0.0

# Database Connection (Default SQLite, supports postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///workflows.db

# AI Model Provider Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# JWT Authentication Settings
JWT_SECRET_KEY=ai-agent-project-lgv3-jwt-secret-key-super-secure-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

