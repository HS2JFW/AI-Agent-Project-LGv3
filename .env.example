# ==============================================================================
# AI Agent Visual Workflow Builder (LGv3) - Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Backend Server Configuration
PORT=8001
HOST=0.0.0.0
DATABASE_URL=sqlite+aiosqlite:///workflows.db

# AI Model Provider Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & Authentication (Change JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=ai-agent-project-lgv3-jwt-secret-key-super-secure-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration (Relative /api/ for production proxy, or http://localhost:8001 for local dev)
VITE_BACKEND_URL=http://localhost:8001

