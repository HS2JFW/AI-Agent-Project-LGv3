# ==============================================================================
# AI Agent Visual Workflow Builder (LGv3) - Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Deployment Environment ('production', 'development', or 'test')
ENVIRONMENT=production

# Backend Server Configuration
PORT=8001
HOST=0.0.0.0

# Database Configuration
# - For Docker / Production (PostgreSQL):
#   DATABASE_URL=postgresql+asyncpg://aibuilder:aibuilder_secure_pass_2026@postgres:5432/aibuilder_db
# - For Local Development (SQLite):
#   DATABASE_URL=sqlite+aiosqlite:///workflows.db
DATABASE_URL=postgresql+asyncpg://aibuilder:aibuilder_secure_pass_2026@postgres:5432/aibuilder_db

# Security: JWT Authentication
# IMPORTANT: Generate a cryptographically secure 256-bit random key for production:
# Command: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_secure_random_256_bit_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security: CORS Allowed Origins (Comma-separated list of trusted domains)
CORS_ORIGINS=https://aibuilder-dev.addpay.in.th,http://localhost:5173,http://127.0.0.1:5173

# AI Model Provider Credentials (Optional: can also be configured per-user via UI)
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration (Relative /api/ for production proxy, or http://localhost:8001 for local dev)
VITE_BACKEND_URL=
