# ========================================================
# Coolify Production Environment Variables Configuration
# Copy and paste these into Coolify -> Application -> Environment Variables
# ========================================================

# Gemini API Key (Required for AI Agents & OCR)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, if using GPT-4o models)
OPENAI_API_KEY=

# JWT Secret Key (Used for encrypting authentication tokens)
JWT_SECRET_KEY=change_this_to_a_random_32_char_secure_string_2026

# JWT Token Expiration in Minutes (1440 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

