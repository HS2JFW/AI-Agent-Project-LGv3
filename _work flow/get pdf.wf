{"name":"queue pdf node","description":"test","historyLimit":50,"nodes":[{"id":"node_1782550215835","type":"customNode","position":{"x":1082.00310617358,"y":-274.49257400524425},"data":{"label":"Timer","category":"Actions","name":"Timer","prompt":"","role":"","parameters":{"timerMode":"interval","calendarSpecificDates":[],"calendarPatternType":"daily","intervalValue":7,"intervalUnit":"seconds","schedulerActive":false,"lastRun":"2026-07-20T12:27:34.896Z","runMode":"subflow","activeSubflow":false,"remainingSeconds":7,"runCount":1,"progress":100},"status":"idle"}},{"id":"node_1782865389217","type":"customNode","position":{"x":1219.0868507358114,"y":-23.00784704438516},"data":{"label":"API Incremental","category":"Data Sources","name":"API Incremental","prompt":"","role":"","parameters":{"apiUrl":"https://bqysaldeijwvnhtcfiuj.supabase.co/rest/v1/pdf_table","authHeader":"Bearer sb_publishable_tzQOB9wms5o9q19pA6vFDQ_OK439Ism","anonKeyHeader":"sb_publishable_tzQOB9wms5o9q19pA6vFDQ_OK439Ism","functionName":"GetPDF_Incremental()","apiParameters":"select=number,date,file_url","round":4,"row":2,"apiOutput":"[\n  {\n    \"number\": 14,\n    \"date\": \"2026-07-03\",\n    \"file_url\": \"https://bqysaldeijwvnhtcfiuj.supabase.co/storage/v1/object/public/pdfs/uploads/1782652710143_34vvos.pdf\"\n  },\n  {\n    \"number\": 15,\n    \"date\": \"2026-07-04\",\n    \"file_url\": \"https://bqysaldeijwvnhtcfiuj.supabase.co/storage/v1/object/public/pdfs/uploads/1782652766565_fpbo7d.pdf\"\n  }\n]","activeSubflow":false,"schedulerActive":false,"progress":100},"status":"idle"}},{"id":"node_1783066205651","type":"customNode","position":{"x":1535.976005655774,"y":-22.968968071969357},"data":{"label":"Storage","category":"Actions","name":"Storage","prompt":"","role":"","parameters":{"fileUrl":"","supabaseUrl":"https://bqysaldeijwvnhtcfiuj.supabase.co/rest/v1/","supabaseKey":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJxeXNhbGRlaWp3dm5odGNmaXVqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxNTQ3ODUsImV4cCI6MjA5NzczMDc4NX0.XDtZYwErthw6qKBOUXJhh97oVxRgzTgEc8cHRi7YKKc","bucketName":"pdfs","fileName":"","storageOutput":"","activeSubflow":false,"schedulerActive":false,"progress":100},"status":"idle"}},{"id":"node_1783066561941","type":"customNode","position":{"x":1351.8406444013312,"y":138.18020558808814},"data":{"label":"PDF Queue","category":"Actions","name":"PDF Queue","prompt":"","role":"","parameters":{"supabaseUrls":"","bucketName":"pdfs","currentIndex":0,"queueLength":0,"currentUrl":"","hasNext":false,"activeSubflow":false,"schedulerActive":false,"pdfQueue":[],"fileStatuses":["Complete","Complete","Complete","Complete","Complete","Complete"],"progress":100,"previous_max":6},"status":"idle"}},{"id":"node_1783577332342","type":"customNode","position":{"x":2042.3024689154797,"y":435.61575436404655},"data":{"label":"AI Agent API PDFs","category":"Agents","name":"AI Agent API PDFs","prompt":"คุณคือ AI Agent ผู้เชี่ยวชาญด้านการทำ OCR (Optical Character Recognition) ภาษาไทยที่มีความแม่นยำระดับสูงสุด หน้าที่ของคุณคือการถอดข้อความจากไฟล์ PDF ที่แนบมานี้ให้เป็นตัวอักษรแบบ \"คำต่อคำ\" ตั้งแต่หน้าแรกจนถึงหน้าสุดท้าย โดยห้ามตกหล่นแม้แต่ตัวเดียว\n\nกฎเหล็กเพื่อความแม่นยำสูงสุดในการประมวลผลภาษาไทย:\n1. ถอดความแบบคำต่อคำ (Verbatim): ให้คัดลอกข้อความทุกคำ ทุกประโยค ห้ามสรุปความ ห้ามข้ามข้อความ ห้ามตัดทอน และห้ามเขียนใหม่ด้วยสำนวนตัวเองเด็ดขาด\n2. ความถูกต้องของอักขระภาษาไทย: ตรวจสอบสระ (บน-ล่าง เช่น สระอุ สระอู สระอี) และวรรณยุกต์ (ไม้เอก ไม้โท ไม้ตรี ไม้จัตวา) อย่างเข้มงวด ห้ามให้สระหรือวรรณยุกต์ตกหล่น ลอย หรือตำแหน่งผิดเพี้ยน และคงการเว้นวรรค (Spacing) ระหว่างประโยคตามต้นฉบับจริง\n3. ห้ามแก้ไขคำผิด (No Auto-Correction): หากต้นฉบับมีการสะกดผิด พิมพ์ตก หรือใช้คำวิบัติ ให้คงคำผิดนั้นไว้ตามต้นฉบับทุกประการ ห้ามแก้ไขให้ถูกต้องเอง\n4. ระบุเลขหน้าอย่างชัดเจน: ให้ประมวลผลเรียงตามลำดับหน้า และต้องใส่เครื่องหมายแบ่งหน้าทุกครั้งในรูปแบบ \"--- หน้า X ---\" (แทนที่ X ด้วยเลขหน้าจริง) ก่อนเริ่มข้อความของหน้านั้นๆ\n5. คงโครงสร้างเอกสาร (Layout): รักษาการย่อหน้า (Paragraph) การขึ้นบรรทัดใหม่ และหัวข้อสัญลักษณ์ (Bullet points) ให้ตรงตามต้นฉบับ\n6. การจัดการตาราง: หากพบตารางข้อมูล ให้ถอดข้อมูลในตารางออกมาให้อยู่ในรูปแบบ Markdown Table อย่างถูกต้องและเป็นระเบียบ\n7. ข้อความที่อ่านไม่ออก: หากมีข้อความที่เบลอมาก หมึกจาง หรือฉีกขาดจนอ่านไม่ได้จริงๆ ห้ามเดาคำ ให้พิมพ์แทนด้วยสัญลักษณ์ [ไม่สามารถอ่านได้: ระบุลักษณะที่พบ เช่น ตัวอักษรจาง/เบลอ]\n8. ส่วนหัวและส่วนท้าย: ให้ถอดความ หัวกระดาษ (Header) ท้ายกระดาษ (Footer) และเลขหน้าของทุกหน้ามาด้วย\n\nรูปแบบผลลัพธ์ (Output Format):\n--- หน้า 1 ---\n[ข้อความภาษาไทยที่ถอดจากหน้า 1]\n\n--- หน้า 2 ---\n[ข้อความภาษาไทยที่ถอดจากหน้า 2]","role":"You are an expert OCR Agent","parameters":{"modelName":"gemini-3.1-flash-lite","temperature":0,"maxOutputTokens":2048,"topP":1,"topK":40,"safetySettings":"BLOCK_MEDIUM_AND_ABOVE","recursionLimit":20,"stateSchema":"messages, remaining_chunks, pdf_content","configurableModel":"default","configurableTemp":"","langsmithTracing":true,"langsmithProject":"gemini-pdf-summarizer","langsmithTags":"v1-test, temp-0","langsmithMetadata":"{\n  \"user_id\": \"123\"\n}","googleApiKey":"","pdfUrls":"","activeSubflow":false,"schedulerActive":false,"agentOutput":"","agentOutputsTable":["1-1782652671316_wm8eqk-2607182214.txt"],"agentResultQueue":[],"agentOutputs":[],"currentJsonFile":"","currentOutputFile":"joint_idx0_20260717113320.txt","hasNext":true,"agentOutputStatusesMap":{"node_1783577332342_1782652837337_l1dcki.txt":"Complete","node_1783577332342_1782652845072_vo4fi8.txt":"Complete","joint_idx0_20260717113320.txt":"Complete","2-1782652661620_vuh8bc-2607181921.txt":"Complete"},"progress":100,"currentIndex":1,"queueLength":2,"previous_max":1,"pdfQueue":["1-1782652671316_wm8eqk-2607182214.pdf","2-1782652691808_tp874r-2607182214.pdf","1-1782652671316_wm8eqk-2607182213.pdf","2-1782652691808_tp874r-2607182213.pdf","1-1782652671316_wm8eqk-2607182212.pdf","2-1782652691808_tp874r-2607182212.pdf"]},"status":"idle"}},{"id":"node_1783605725838","type":"customNode","position":{"x":1942.