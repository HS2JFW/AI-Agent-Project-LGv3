ithTags":"v1-test, temp-0","langsmithMetadata":"{\n  \"user_id\": \"123\"\n}","googleApiKey":"","pdfUrls":"","agentOutputsTable":["1-1782652654508_co97ym-2607181922.txt"],"schedulerActive":false,"activeSubflow":false,"progress":100,"currentIndex":1,"previous_max":1,"queueLength":2,"pdfQueue":["1-1782652654508_co97ym-2607181921.pdf","2-1782652661620_vuh8bc-2607181921.pdf"],"hasNext":true},"status":"idle"}},{"id":"node_1784190707615","type":"customNode","position":{"x":573.615443127974,"y":375.57253922942203},"data":{"label":"AI Agent API","category":"Agents","name":"AI Agent API","nodeClass":"AI Agent API","originalName":"AI Agent API","nodeType":"AI Agent API","prompt":"คุณคือ AI Agent ผู้เชี่ยวชาญด้านการทำ OCR (Optical Character Recognition) ภาษาไทยที่มีความแม่นยำระดับสูงสุด หน้าที่ของคุณคือการถอดข้อความจากไฟล์ PDF ที่แนบมานี้ให้เป็นตัวอักษรแบบ \"คำต่อคำ\" ตั้งแต่หน้าแรกจนถึงหน้าสุดท้าย โดยห้ามตกหล่นแม้แต่ตัวเดียว\n\nกฎเหล็กเพื่อความแม่นยำสูงสุดในการประมวลผลภาษาไทย:\n1. ถอดความแบบคำต่อคำ (Verbatim): ให้คัดลอกข้อความทุกคำ ทุกประโยค ห้ามสรุปความ ห้ามข้ามข้อความ ห้ามตัดทอน และห้ามเขียนใหม่ด้วยสำนวนตัวเองเด็ดขาด\n2. ความถูกต้องของอักขระภาษาไทย: ตรวจสอบสระ (บน-ล่าง เช่น สระอุ สระอู สระอี) และวรรณยุกต์ (ไม้เอก ไม้โท ไม้ตรี ไม้จัตวา) อย่างเข้มงวด ห้ามให้สระหรือวรรณยุกต์ตกหล่น ลอย หรือตำแหน่งผิดเพี้ยน และคงการเว้นวรรค (Spacing) ระหว่างประโยคตามต้นฉบับจริง\n3. ห้ามแก้ไขคำผิด (No Auto-Correction): หากต้นฉบับมีการสะกดผิด พิมพ์ตก หรือใช้คำวิบัติ ให้คงคำผิดนั้นไว้ตามต้นฉบับทุกประการ ห้ามแก้ไขให้ถูกต้องเอง\n4. ระบุเลขหน้าอย่างชัดเจน: ให้ประมวลผลเรียงตามลำดับหน้า และต้องใส่เครื่องหมายแบ่งหน้าทุกครั้งในรูปแบบ \"--- หน้า X ---\" (แทนที่ X ด้วยเลขหน้าจริง) ก่อนเริ่มข้อความของหน้านั้นๆ\n5. คงโครงสร้างเอกสาร (Layout): รักษาการย่อหน้า (Paragraph) การขึ้นบรรทัดใหม่ และหัวข้อสัญลักษณ์ (Bullet points) ให้ตรงตามต้นฉบับ\n6. การจัดการตาราง: หากพบตารางข้อมูล ให้ถอดข้อมูลในตารางออกมาให้อยู่ในรูปแบบ Markdown Table อย่างถูกต้องและเป็นระเบียบ\n7. ข้อความที่อ่านไม่ออก: หากมีข้อความที่เบลอมาก หมึกจาง หรือฉีกขาดจนอ่านไม่ได้จริงๆ ห้ามเดาคำ ให้พิมพ์แทนด้วยสัญลักษณ์ [ไม่สามารถอ่านได้: ระบุลักษณะที่พบ เช่น ตัวอักษรจาง/เบลอ]\n8. ส่วนหัวและส่วนท้าย: ให้ถอดความ หัวกระดาษ (Header) ท้ายกระดาษ (Footer) และเลขหน้าของทุกหน้ามาด้วย\n\nรูปแบบผลลัพธ์ (Output Format):\n--- หน้า 1 ---\n[ข้อความภาษาไทยที่ถอดจากหน้า 1]\n\n--- หน้า 2 ---\n[ข้อความภาษาไทยที่ถอดจากหน้า 2]   รวมถึงให้ \"วิเคราะห์จากโครงการที่ส่งมาด้วย จากตาราง multi criteria analysit ว่าคะแนนควรเป็นเท่าไหร่ ขอผลคะแนนที่คุณวิเคราะห์ตามหัวข้อ criteria เท่านั้น\n\nตัวอย่างผลลัพธ์= เนื้อหาชัดเจน->3 เนื้อหาเร่าร้อน-4 และอธิบายเหตุผล\n\n[สำคัญมาก]: ห้ามคัดลอกหรือยกข้อความจากเอกสารต้นฉบับมาตอบแบบตรงๆ (Do not quote verbatim) ให้อธิบายเหตุผลโดยการสรุปและเรียบเรียงใหม่ด้วยคำพูดของคุณเองทั้งหมดแบบสั้นๆ เพื่อหลีกเลี่ยงปัญหาด้านลิขสิทธิ์\"\n","role":"Agent Role","parameters":{"modelName":"gemini-3.1-flash-lite","temperature":0,"maxOutputTokens":2048,"topP":1,"topK":40,"safetySettings":"BLOCK_MEDIUM_AND_ABOVE","recursionLimit":20,"stateSchema":"messages, remaining_chunks, pdf_content","configurableModel":"default","configurableTemp":"","langsmithTracing":true,"langsmithProject":"gemini-pdf-summarizer","langsmithTags":"v1-test, temp-0","langsmithMetadata":"{\n  \"user_id\": \"123\"\n}","googleApiKey":"","schedulerActive":false,"activeSubflow":false,"progress":100,"agentOutput":"","hasNext":true,"currentIndex":0},"status":"idle"}},{"id":"node_1784377047355","type":"mca","position":{"x":523.3613643181845,"y":536.9099054869346},"data":{"label":"Multi-Criteria Analysis","category":"Criteria","name":"Multi-Criteria Analysis","nodeClass":"Multi-Criteria Analysis","originalName":"Multi-Criteria Analysis","nodeType":"Multi-Criteria Analysis","prompt":"","role":"","parameters":{"schedulerActive":false,"activeSubflow":false,"progress":100,"output":"Processed node: Multi-Criteria Analysis"},"rubricData":{"levels":[{"id":"l1","name":"ระดับวิกฤต / เชิงลบขั้นรุนแรง","score":-5},{"id":"l2","name":"ระดับบกพร่อง / มีความเสี่ยง","score":-2},{"id":"l3","name":"ระดับเป็นกลาง / ตามเกณฑ์","score":0},{"id":"l4","name":"ระดับส่งเสริม / เชิงบวก","score":3},{"id":"l1784435764123","name":"ระดับดีเลิศ / นวัตกรรมเชิงระบบ","score":5}],"criteria":[{"id":"c1","name":"1. สุจริต (Integrity)","descriptions":{"l1":"<p><strong>มีการทุจริตเชิงนโยบายชัดเจน</strong> เช่น ล็อกสเปกเอื้อประโยชน์ทุนผูกขาด ขัดขวางการแข่งขันอย่างเป็นธรรม</p>","l2":"<p>ขาดกลไกการเปิดเผยข้อมูล ยื่นซองกระชั้นชิด เสี่ยงเกิดผลประโยชน์ทับซ้อน</p>","l3":"<p>ข้อมูล ยื่นซองกระชั้นชิด เสี่ยงเกิดผลประโยชน์ทับซ้อนดำเนินการตามระเบียบพัสดุขั้นต่ำของรัฐ ไม่มีกลไกป้องกันทุจริตเพิ่มเติม</p>","l4":"<p>มีมาตรการเปิดเผยราคากลางย่อย เข้าร่วมข้อตกลงคุณธรรม (Integrity Pact) มีบุคคลภายนอกร่วมสังเกตการณ์</p>","l1784435764123":"<p><strong>โปร่งใสเชิงรุก (Open Data)</strong> เปิดเผยข้อมูลทุกขั้นตอนผ่านระบบดิจิทัล มีกลไก Zero-Tolerance บังคับบทลงโทษสูงสุด</p>"},"weight":30},{"id":"c1784377081998","name":"2. พอเพียง (Sufficiency)","descriptions":{"l3":"<p>ใช้งบประมาณตามกรอบมาตรฐานทั่วไปของสำนักงบประมาณ ไม่มีมาตรการประหยัด</p>","l4":"<p>มีแผนบริหารความเสี่ยง คำนึงถึงต้นทุนตลอดอายุการใช้งาน (Life-Cycle Cost)</p>","l1":"<p><strong>ฟุ่มเฟือย/ซ้ำซ้อนอย่างรุนแรง</strong> ตั้งงบประมาณสูงเกินจริง (Overpriced) ไม่คุ้มค่าเชิงเศรษฐกิจ</p>","l2":"<p>ขาดการประเมินความคุ้มค่าระยะยาว ใช้วัสดุหรือเทคโนโลยีที่สร้างภาระการบำรุงรักษาสูงเกินจำเป็น</p>","l1784435764123":"<p>คำนึงถึงต้นทุนตลอดอายุการใช้งาน (Life-Cycle Cost)<strong>คุ้มค่าและยั่งยืนสูงสุด</strong> เน้นพึ่งพาเทคโนโลยีในประเทศ/ท้องถิ่น มีแผนรองรับวิกฤตและความยืดหยุ่นสูง (Resilience)</p>"},"weight":20},{"id":"c1784435367522","name":"3. วินัย (Discipline)","descriptions":{"l1":"<p><strong>ขัดต่อกฎหมายจัดซื้อจัดจ้าง</strong> หรือละเลยมาตรฐานความปลอดภัยทางวิศวกรรม/วิชาชีพอย่างร้ายแรง</p>","l2":"<p>กำหนดเวลาส่งมอบงานไม่สมเหตุสมผล (เร่งรัดเกินไปจนลดคุณภาพ หรือเอื้อให้ขยายเวลาได้ง่าย)</p>","l3":"<p>เป็นไปตามระเบียบ กฎหมาย และมาตรฐานวิชาชีพทั่วไป</p>","l4":"<p>มีเกณฑ์การควบคุมคุณภาพ (QA/QC) ที่รัดกุม มีบทลงโทษและการปรับที่ชัดเจนเมื่อทำผิดสัญญา</p>","l1784435764123":"<p>มีระบบติดตามความคืบหน้าแบบ Real-time มีเกณฑ์ประเมินผู้รับจ้างขั้นสูงเพื่อยกระดับมาตรฐานอุตสาหกรรม</p>"},"weight":15},{"id":"c1784435368434","name":"4. จิตอาสา (Public Mind)","descriptions":{"l1":"<p><strong>สร้างผลกระทบเชิงลบต่อสาธารณะ</strong> เอื้อประโยชน์กลุ่มทุนโดยทิ้งภาระความเสียหายหรือมลพิษไว้กับชุมชน</p>","l2":"<p>ละเลยการรับฟังเสียงของประชาชน ขาดการระบุถึงประโยชน์ที่ชุมชนจะได้รับโดยตรง</p>","l3":"<p>โครงการมุ่งตอบสนองภารกิจของหน่วยงานรัฐเป็นหลัก ไม่สร้างผลกระทบด้านบวกหรือลบต่อสังคม</p>","l4":"<p>มีกระบวนการรับฟังความคิดเห็น มีข้อกำหนดให้ผู้รับจ้างทำกิจกรรมเพื่อสังคม (CSR) ในพื้นที่</p>","l1784435764123":"<p><strong>ยึดประชาชนเป็นศูนย์กลาง</strong> ประชาชนมีส่วนร่วมตรวจสอบ ออกแบบเพื่อลดความเหลื่อมล้ำและช่วยกลุ่มเปราะบาง</p>"},"weight":15},{"id":"c1784435369438","name":"5. กตัญญู (Responsibility & Sustainability)","descriptions":{"l1":"<p><strong>ทำลายทรัพยากรชาติอย่างร้ายแรง</strong> ปล่อยมลพิษ ทำลายประวัติศาสตร์/วัฒนธรรมท้องถิ่นเพื่อประโยชน์ระยะสั้น</p>","l2":"<p>ขาดแผนการฟื้นฟูสิ่งแวดล้อม หรือไม่มีมาตรการเยียวยาทุนทางสังคมในระยะยาว</p>","l3":"<p>ไม่ส่งผลกระทบต่อสิ่งแวดล้อมหรือวัฒนธรรม (เช่น โครงการจัดซื้อซอฟต์แวร์/ธุรการทั่วไป)</p>","l4":"<p>มีเงื่อนไขการใช้วัสดุเป็นมิตรต่อสิ่งแวดล้อม (Green Procurement) หรือประหยัดพลังงาน</p>","l1784435764123":"<p><strong>มุ่งสู่ความยั่งยืนขั้นสูงสุด</strong> (เช่น Net Zero, BCG Model) ปกป้องและส่งมอบมรดกทางธรรมชาติ/วัฒนธรรมให้คนรุ่นหลัง</p>"},"weight":20}],"explain":"สูตรสมการ MCA$$Total Score = \\sum_{i=1}^{n} (S_i \\times W_i)$$เขียนเป็นภาษาที่เข้าใจง่าย:คะแนนรวม MCA = (คะแนนดิบด้านที่ 1 $\\times$ น้ำหนักด้านที่ 1) + (คะแนนดิบด้านที่ 2 $\\times$ น้ำหนักด้านที่ 2) + ... + (คะแนนดิบด้านที่ 5 $\\times$ น้ำหนักด้านที่ 5)"},"status":"idle"}},{"id":"node_1784390876035","type":"customNode","position":{"x":954.4101365853242,"y":965.6484138223252},"data":{"label":"AI Agent PDFs","category":"Agents","name":"AI Agent PDFs","nodeClass":"AI Agent PDFs","originalName":"AI Agent PDFs","nodeType":"AI Agent PDFs","prompt":"ให้คะแนนแต่ละโครงการ ตาม MCA table ที่ส่งให้ โดยสรุป คะแนน แต่ละ criteria และ คะแนนรวม ของ โครงการ โดยอยู๋ใน format นี้    สุจริต : [คะแนน] {เหตุผลเชื่อมโยงกับ ตาราง MCA}, พ่อเพียง : [คะแนน] {เหตุผลเชื่อมโยงกับ ตาราง MCA},วินัย : [คะแนน]{เหตุผลเชื่อมโยงกับ ตาราง MCA}, จิตอาสา: [คะแนน]{เหตุผลเชื่อมโยงกับ ตาราง MCA}, กตัญญู : [คะแนน] {เหตุผลเชื่อมโยงกับ ตาราง MCA} , คะแนนรวม ของโครงการ","role":"Agent Role","parameters":{"modelName":"gemini-3-flash-preview","temperature":0,"maxOutputTokens":2048,"topP":1,"topK":40,"safetySettings":"BLOCK_MEDIUM_AND_ABOVE","recursionLimit":20,"stateSchema":"messages, remaining_chunks, pdf_content","configurableModel":"default","configurableTemp":"","langsmithTracing":true,"langsmithProject":"gemini-pdf-summarizer","langsmithTags":"v1-test, temp-0","langsmithMetadata":"{\n  \"user_id\": \"123\"\n}","googleApiKey":"","pdfUrls":"","agentOutputsTable":[],"schedulerActive":false,"activeSubflow":false,"progress":100,"agentOutput":"","agentResultQueue":[],"agentOutputs":[],"currentJsonFile":"","currentIndex":0,"hasNext":false,"queueLength":0,"previous_max":2,"pdfQueue":["1-1782652671316_wm8eqk-2607191632.pdf","2-1782652691808_tp874r-2607191632.pdf"]},"status":"idle"}},{"id":"node_1784435960141","type":"sample","position":{"x":141.98472553699276,"y":373.2687350835322},"data":{"label":"Sample","category":"Criteria","name":"Sample","nodeClass":"Sample","originalName":"Sample","nodeType":"Sample","prompt":"","role":"","parameters":{"schedulerActive":false,"activeSubflow":false},"sampleData":{"samples":[{"id":"sample-1","name":"ตัวอย่าง 1","scores":{}}],"criteria":[{"id":"crit-1","name":"[ชื่อเกณฑ์ที่ 1]"}],"sampleColumnName":"Sample"},"status":"idle"}},{"id":"node_1784451959359","type":"customNode","position":{"x":902.6409636893147,"y":367.10802978350364},"data":{"label":"AI Agent PDFs Base64","category":"Agents","name":"AI Agent PDFs Base64","nodeClass":"AI Agent PDFs Base64","originalName":"AI Agent PDFs Base64","nodeType":"AI Agent PDFs Base64","prompt":"คุณคือ AI Agent ผู้เชี่ยวชาญด้านการทำ OCR (Optical Character Recognition) ภาษาไทยที่มีความแม่นยำระดับสูงสุด หน้าที่ของคุณคือการถอดข้อความจากไฟล์ PDF ที่แนบมานี้ให้เป็นตัวอักษรแบบ \"คำต่อคำ\" ตั้งแต่หน้าแรกจนถึงหน้าสุดท้าย โดยห้ามตกหล่นแม้แต่ตัวเดียว\n\nกฎเหล็กเพื่อความแม่นยำสูงสุดในการประมวลผลภาษาไทย:\n1. ถอดความแบบคำต่อคำ (Verbatim): ให้คัดลอกข้อความทุกคำ ทุกประโยค ห้ามสรุปความ ห้ามข้ามข้อความ ห้ามตัดทอน และห้ามเขียนใหม่ด้วยสำนวนตัวเองเด็ดขาด\n2. ความถูกต้องของอักขระภาษาไทย: ตรวจสอบสระ (บน-ล่าง เช่น สระอุ สระอู สระอี) และวรรณยุกต์ (ไม้เอก ไม้โท ไม้ตรี ไม้จัตวา) อย่างเข้มงวด ห้ามให้สระหรือวรรณยุกต์ตกหล่น ลอย หรือตำแหน่งผิดเพี้ยน และคงการเว้นวรรค (Spacing) ระหว่างประโยคตามต้นฉบับจริง\n3. ห้ามแก้ไขคำผิด (No Auto-Correction): หากต้นฉบับมีการสะกดผิด พิมพ์ตก หรือใช้คำวิบัติ ให้คงคำผิดนั้นไว้ตามต้นฉบับทุกประการ ห้ามแก้ไขให้ถูกต้องเอง\n4. ระบุเลขหน้าอย่างชัดเจน: ให้ประมวลผลเรียงตามลำดับหน้า และต้องใส่เครื่องหมายแบ่งหน้าทุกครั้งในรูปแบบ \"--- หน้า X ---\" (แทนที่ X ด้วยเลขหน้าจริง) ก่อนเริ่มข้อความของหน้านั้นๆ\n5. คงโครงสร้างเอกสาร (Layout): รักษาการย่อหน้า (Paragraph) การขึ้นบรรทัดใหม่ และหัวข้อสัญลักษณ์ (Bullet points) ให้ตรงตามต้นฉบับ\n6. การจัดการตาราง: หากพบตารางข้อมูล ให้ถอดข้อมูลในตารางออกมาให้อยู่ในรูปแบบ Markdown Table อย่างถูกต้องและเป็นระเบียบ\n7. ข้อความที่อ่านไม่ออก: หากมีข้อความที่เบลอมาก หมึกจาง หรือฉีกขาดจนอ่านไม่ได้จริงๆ ห้ามเดาคำ ให้พิมพ์แทนด้วยสัญลักษณ์ [ไม่สามารถอ่านได้: ระบุลักษณะที่พบ เช่น ตัวอักษรจาง/เบลอ]\n8. ส่วนหัวและส่วนท้าย: ให้ถอดความ หัวกระดาษ (Header) ท้ายกระดาษ (Footer) และเลขหน้าของทุกหน้ามาด้วย\n\n","role":"AI Agent API PDFs","parameters":{"modelName":"openai/gpt-5.6-luna","temperature":0,"maxOutputTokens":2048,"topP":1,"topK":40,"safetySettings":"BLOCK_MEDIUM_AND_ABOVE","recursionLimit":20,"stateSchema":"messages, remaining_chunks, pdf_content","configurableModel":"default","configurableTemp":"","langsmithTracing":true,"langsmithProject":"gemini-pdf-summarizer","langsmithTags":"v1-test, temp-0","langsmithMetadata":"{\n  \"user_id\": \"123\"\n}","googleApiKey":"","pdfUrls":"","agentOutputsTable":[],"schedulerActive":false,"activeSubflow":false,"progress":100,"currentIndex":2,"previous_max":2,"queueLength":0,"pdfQueue":[],"hasNext":false,"agentOutput":"","agentResultQueue":[],"agentOutputs":[],"currentJsonFile":""},"status":"idle"}},{"id":"node_1784456850978","type":"customNode","position":{"x":1178.026654978433,"y":367.8499235089038},"data":{"label":"AI Agent PDFs Image","category":"Agents","name":"AI Agent PDFs Image","nodeClass":"AI Agent PDFs Image","originalName":"AI Agent PDFs Image","nodeType":"AI Agent PDFs Image","prompt":"คุณคือ AI Agent ผู้เชี่ยวชาญด้านการทำ OCR (Optical Character Recognition) ภาษาไทยที่มีความแม่นยำระดับสูงสุด หน้าที่ของคุณคือการถอดข้อความจากไฟล์ PDF ที่แนบมานี้ให้เป็นตัวอักษรแบบ \"คำต่อคำ\" ตั้งแต่หน้าแรกจนถึงหน้าสุดท้าย โดยห้ามตกหล่นแม้แต่ตัวเดียว\n\nกฎเหล็กเพื่อความแม่นยำสูงสุดในการประมวลผลภาษาไทย:\n1. ถอดความแบบคำต่อคำ (Verbatim): ให้คัดลอกข้อความทุกคำ ทุกประโยค ห้ามสรุปความ ห้ามข้ามข้อความ ห้ามตัดทอน และห้ามเขียนใหม่ด้วยสำนวนตัวเองเด็ดขาด\n2. ความถูกต้องของอักขระภาษาไทย: ตรวจสอบสระ (บน-ล่าง เช่น สระอุ สระอู สระอี) และวรรณยุกต์ (ไม้เอก ไม้โท ไม้ตรี ไม้จัตวา) อย่างเข้มงวด ห้ามให้สระหรือวรรณยุกต์ตกหล่น ลอย หรือตำแหน่งผิดเพี้ยน และคงการเว้นวรรค (Spacing) ระหว่างประโยคตามต้นฉบับจริง\n3. ห้ามแก้ไขคำผิด (No Auto-Correction): หากต้นฉบับมีการสะกดผิด พิมพ์ตก หรือใช้คำวิบัติ ให้คงคำผิดนั้นไว้ตามต้นฉบับทุกประการ ห้ามแก้ไขให้ถูกต้องเอง\n4. ระบุเลขหน้าอย่างชัดเจน: ให้ประมวลผลเรียงตามลำดับหน้า และต้องใส่เครื่องหมายแบ่งหน้าทุกครั้งในรูปแบบ \"--- หน้า X ---\" (แทนที่ X ด้วยเลขหน้าจริง) ก่อนเริ่มข้อความของหน้านั้นๆ\n5. คงโครงสร้างเอกสาร (Layout): รักษาการย่อหน้า (Paragraph) การขึ้นบรรทัดใหม่ และหัวข้อสัญลักษณ์ (Bullet points) ให้ตรงตามต้นฉบับ\n6. การจัดการตาราง: หากพบตารางข้อมูล ให้ถอดข้อมูลในตารางออกมาให้อยู่ในรูปแบบ Markdown Table อย่างถูกต้องและเป็นระเบียบ\n7. ข้อความที่อ่านไม่ออก: หากมีข้อความที่เบลอมาก หมึกจาง หรือฉีกขาดจนอ่านไม่ได้จริงๆ ห้ามเดาคำ ให้พิมพ์แทนด้วยสัญลักษณ์ [ไม่สามารถอ่านได้: ระบุลักษณะที่พบ เช่น ตัวอักษรจาง/เบลอ]\n8. ส่วนหัวและส่วนท้าย: ให้ถอดความ หัวกระดาษ (Header) ท้ายกระดาษ (Footer) และเลขหน้าของทุกหน้ามาด้วย","role":"AI Agent API PDFs","parameters":{"modelName":"google/gemini-3.5-flash","temperature":0,"maxOutputTokens":2048,"topP":1,"topK":40,"safetySettings":"BLOCK_MEDIUM_AND_ABOVE","recursionLimit":20,"stateSchema":"messages, remaining_chunks, pdf_content","configurableModel":"default","configurableTemp":"","langsmithTracing":true,"langsmithProject":"gemini-pdf-summarizer","langsmithTags":"v1-test, temp-0","langsmithMetadata":"{\n  \"user_id\": \"123\"\n}","googleApiKey":"","pdfUrls":"","agentOutputsTable":[],"schedulerActive":false,"activeSubflow":false,"progress":100,"currentIndex":0,"previous_max":0,"queueLength":0,"pdfQueue":[],"hasNext":false,"agentOutput":"","agentResultQueue":[],"agentOutputs":[],"currentJsonFile":""},"status":"idle"}},{"id":"node_1784646373797","type":"customNode","position":{"x":1733.4455158617438,"y":384.21138633067744},"data":{"label":"AI Agent PDFs","category":"OCR","name":"AI Agent PDFs","nodeClass":"AI Agent PDFs","originalName":"AI Agent PDFs","nodeType":"AI Agent PDFs","prompt":"คุณคือ AI Agent ผู้เชี่ยวชาญด้านการทำ OCR (Optical Character Recognition) ภาษาไทยที่มีความแม่นยำระดับสูงสุด หน้าที่ของคุณคือการถอดข้อความจากไฟล์ PDF ที่แนบมานี้ให้เป็นตัวอักษรแบบ \"คำต่อคำ\" ตั้งแต่หน้าแรกจนถึงหน้าสุดท้าย โดยห้ามตกหล่นแม้แต่ตัวเดียว\n\nกฎเหล็กเพื่อความแม่นยำสูงสุดในการประมวลผลภาษาไทย:\n1. ถอดความแบบคำต่อคำ (Verbatim): ให้คัดลอกข้อความทุกคำ ทุกประโยค ห้ามสรุปความ ห้ามข้ามข้อความ ห้ามตัดทอน และห้ามเขียนใหม่ด้วยสำนวนตัวเองเด็ดขาด\n2. ความถูกต้องของอักขระภาษาไทย: ตรวจสอบสระ (บน-ล่าง เช่น สระอุ สระอู สระอี) และวรรณยุกต์ (ไม้เอก ไม้โท ไม้ตรี ไม้จัตวา) อย่างเข้มงวด ห้ามให้สระหรือวรรณยุกต์ตกหล่น ลอย หรือตำแหน่งผิดเพี้ยน และคงการเว้นวรรค (Spacing) ระหว่างประโยคตามต้นฉบับจริง\n3. ห้ามแก้ไขคำผิด (No Auto-Correction): หากต้นฉบับมีการสะกดผิด พิมพ์ตก หรือใช้คำวิบัติ ให้คงคำผิดนั้นไว้ตามต้นฉ