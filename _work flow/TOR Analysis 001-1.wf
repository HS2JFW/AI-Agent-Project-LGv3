    {
      "id": "node_1785735022213",
      "type": "table",
      "position": {
        "x": 466.28460030594806,
        "y": 132.0821366268591
      },
      "data": {
        "label": "Table",
        "category": "Criteria",
        "name": "Table",
        "nodeClass": "Table",
        "originalName": "Table",
        "nodeType": "Table",
        "prompt": "",
